rules_version = '2';

// StrengthHub — Firestore security rules (hardened per the Database Security
// Hardening Plan v3, sections 4, 6, 7.4 and the Zone A/B/C trust zones).
//
// Data model (see src/store/cloudRepo.ts and src/backend/repo/*):
//   users/{uid}                    ← the user's singleton state document (Zone A)
//   users/{uid}/{collection}/{id}  ← one document per entry for each unbounded
//                                     log. Every collection is ALLOWLISTED with
//                                     its OWN typed rule; an unknown collection
//                                     name or unexpected nested path is denied.
//   entitlements/{uid}             ← server-owned authoritative state (Zone B):
//                                     owner-read, all client writes denied.
//   config/coach                   ← single global coach runtime config (read-only)
//
// Hardening layers on top of owner-only isolation:
//   1. Structural allowlist — keys().hasOnly(...) on the root and per-entry key
//      caps, so a client cannot invent unknown top-level fields, unknown
//      collections, or unexpected nested paths. This REPLACES the old
//      `size() < 60` heuristic, which an attacker could satisfy while hiding
//      ~1 MB inside a single nested field (plan §4.5 note).
//   2. Identifier/ownership invariants — an embedded id/dateKey/uid must agree
//      with the document path (plan §4.4), so internally-inconsistent documents
//      cannot be written.
//   3. Field-level entitlement guard — profile.premium is a Zone A DISPLAY
//      cache only; the client may create it as false and may never flip it.
//      The authoritative entitlement lives in the server-owned
//      entitlements/{uid} document (plan §3, §4.7).
//   4. Free-text size caps derived from the UI / plan §4.5.
// Everything else is denied by default.
//
// NOTE — Security Rules are the database schema. A new collection or top-level
// field cannot ship without adding its rule + tests here (plan §1 note, §13).
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------- //
    //  Zone A — client-owned personal data: users/{uid} and subtree      //
    // ----------------------------------------------------------------- //
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // --- root singleton document ------------------------------------ //

      // The complete set of top-level fields the app persists to the root doc
      // (AppState minus the unbounded arrays that live in subcollections, plus
      // the server-written `updatedAt`). See src/store/types.ts (AppState) and
      // src/store/cloudRepo.ts (SUBCOLLECTIONS). Keep in sync with both.
      function rootAllowedKeys() {
        return [
          'profile', 'settings', 'mealPlan', 'postComments', 'nutritionTags',
          'foods', 'program', 'posts', 'leaderboard', 'challenges', 'badges',
          'events', 'groups', 'partners', 'myMeals', 'templates',
          'workoutStartedKeys', 'nutritionAskedKeys', 'beginnerProgress',
          'coachUsage', 'integrations', 'plannedPeriods', 'backendUser',
          'generatedProgram', 'workoutInstances', 'programStatus', 'demo', 'v',
          'updatedAt'
        ];
      }

      function rootKeysAllowed() {
        return request.resource.data.keys().hasOnly(rootAllowedKeys());
      }

      // Light top-level type checks. Optional fields pass when absent so that
      // merge writers (e.g. userRepo writing only `backendUser`) and legacy
      // saves are never rejected on a field they simply don't carry.
      function rootTypesOk() {
        let d = request.resource.data;
        return (!('profile' in d)          || d.profile is map)
          && (!('settings' in d)           || d.settings is map)
          && (!('foods' in d)              || d.foods is list)
          && (!('program' in d)            || d.program is list)
          && (!('posts' in d)              || d.posts is list)
          && (!('badges' in d)             || d.badges is list)
          && (!('templates' in d)          || d.templates is list)
          && (!('plannedPeriods' in d)     || d.plannedPeriods is list)
          && (!('backendUser' in d)        || d.backendUser is map)
          && (!('integrations' in d)       || d.integrations is map)
          && (!('coachUsage' in d)         || d.coachUsage is map)
          && (!('demo' in d)               || d.demo is bool)
          && (!('v' in d)                  || d.v is int)
          && (!('updatedAt' in d)          || d.updatedAt is timestamp || d.updatedAt is string);
      }

      // --- entitlement guard (profile.premium) — Zone A display cache only.
      function newPremium() { return request.resource.data.get('profile', {}).get('premium', false); }
      // Null-safe: on a create there is no `resource`, so treat the prior value
      // as false rather than dereferencing null (avoids a rules evaluation error).
      function oldPremium() { return resource != null ? resource.data.get('profile', {}).get('premium', false) : false; }
      function premiumFalseOnCreate() { return newPremium() == false; }
      function premiumUnchanged()     { return newPremium() == oldPremium(); }

      // --- obsolete third-party credentials (plan §6). OAuth integrations were
      // removed; a client must never (re)introduce top-level plaintext tokens.
      // Any future credentials belong in Secret Manager / a server backend, not
      // in an owner-writable document. (Tokens nested inside `integrations` are
      // additionally stripped by the canonical sanitiser — src/lib/sanitize.ts.)
      function noPlaintextTokens() {
        return !('accessToken' in request.resource.data)
          && !('refreshToken' in request.resource.data);
      }

      // --- free-text caps for the known bounded fields (plan §4.5).
      function rootFreeTextValid() {
        let d = request.resource.data;
        return d.get('profile', {}).get('motivation', '').size() <= 2000
          && d.get('profile', {}).get('injuries', '').size() <= 2000
          && d.get('profile', {}).get('name', '').size() <= 200
          && d.get('backendUser', {}).get('notes', '').size() <= 4000
          && d.get('backendUser', {}).get('motivation', '').size() <= 2000;
      }

      function rootValid() {
        return rootKeysAllowed() && rootTypesOk() && noPlaintextTokens() && rootFreeTextValid();
      }

      // get only — a collection-wide `list` of user roots is never needed and is
      // denied (there is no `list` allow rule here).
      allow get:    if isOwner();
      allow create: if isOwner() && premiumFalseOnCreate() && rootValid();
      allow update: if isOwner() && premiumUnchanged()     && rootValid();
      // Direct client deletion of the root is denied. Account deletion is a
      // controlled backend workflow that removes Auth + Firestore + Storage
      // together (plan §4.2).
      allow delete: if false;

      // --- per-entry shape/size helpers for subcollection docs -------- //
      function entryKeysBounded() { return request.resource.data.size() < 100; }
      function textCap(field, max) { return request.resource.data.get(field, '').size() <= max; }
      // An `id`-keyed entry must embed the document id it is stored under.
      function idMatches(docId) { return request.resource.data.get('id', docId) == docId; }
      // A `dateKey`-keyed entry: the path segment IS the dateKey, in YYYY-MM-DD.
      function dateKeyMatches(docId) {
        return request.resource.data.get('dateKey', docId) == docId
          && docId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      // A backend record whose ownership must agree with the path uid.
      function ownsRecord() { return request.resource.data.get('uid', uid) == uid; }

      // Allowlisted per-user subcollections (plan §4.3, §4.4). Each defines its
      // OWN validation — schemas and risk profiles differ, so there is no single
      // generic entryValid(). Reads/deletes need only ownership; writes also pass
      // the collection's shape/id/size checks. Unknown collection names and
      // unexpected nested paths fall through to the default-deny at the bottom.

      match /sessions/{id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && idMatches(id)
          && textCap('name', 200) && textCap('focus', 200);
      }
      match /weights/{dateKey} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && dateKeyMatches(dateKey);
      }
      match /habits/{dateKey} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && dateKeyMatches(dateKey);
      }
      match /meals/{id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && idMatches(id)
          && textCap('name', 200);
      }
      match /activities/{id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && idMatches(id)
          && textCap('name', 200) && textCap('note', 1000);
      }
      match /foodReviews/{dateKey} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && dateKeyMatches(dateKey)
          && textCap('text', 4000);
      }
      match /chat/{id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && idMatches(id)
          && textCap('text', 8000);
      }
      match /coachThread/{id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && idMatches(id)
          && textCap('title', 200) && textCap('body', 8000);
      }
      match /notifications/{id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && idMatches(id)
          && textCap('title', 200) && textCap('body', 1000);
      }
      match /programs/{program_id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && ownsRecord()
          && request.resource.data.get('program_id', program_id) == program_id;
      }
      match /workout_instances/{instance_id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && ownsRecord()
          && request.resource.data.get('instance_id', instance_id) == instance_id;
      }
      match /set_logs/{log_id} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded() && ownsRecord()
          && request.resource.data.get('log_id', log_id) == log_id;
      }
      match /progression_state/{id} {
        allow get, list, delete: if isOwner();
        // Doc id is `${uid}_${exercise_id}` (src/backend/repo/setLogRepo.ts).
        allow create, update: if isOwner() && entryKeysBounded() && ownsRecord()
          && id == uid + '_' + request.resource.data.get('exercise_id', '');
      }
      match /pushTokens/{token} {
        allow get, list, delete: if isOwner();
        allow create, update: if isOwner() && entryKeysBounded()
          && request.resource.data.get('token', token) == token
          && request.resource.data.get('platform', 'ios')
               in ['ios', 'android', 'web', 'windows', 'macos'];
      }
    }

    // ----------------------------------------------------------------- //
    //  Zone B — server-owned authoritative data: entitlements/{uid}      //
    // ----------------------------------------------------------------- //
    // The authoritative paid-entitlement record. The owner may READ their own
    // document; ALL client writes are denied — only a trusted Admin-SDK service
    // (billing webhook) writes it. An absent document means non-premium; the
    // client must never create a default one (plan §4.7).
    match /entitlements/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ----------------------------------------------------------------- //
    //  Global coach runtime config — exact path only (plan §4.6)         //
    // ----------------------------------------------------------------- //
    // Only config/coach exists (kill switch, message limits, guardrail prompt).
    // Pinning the exact path stops any FUTURE config document from accidentally
    // becoming readable by every authenticated user. Client-write denied.
    match /config/coach {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    // ----------------------------------------------------------------- //
    //  Zone C — public reference content: recipes/{id}                   //
    // ----------------------------------------------------------------- //
    // The recipe catalogue shown in Nutrition → Recipes. Identical for every
    // user, read-only from the client (signed-in feature), and written only by
    // the trusted upload script (Admin SDK) from the recipe spreadsheet. The app
    // bundles a seed copy, so this is an editable overlay, not a hard dependency.
    match /recipes/{id} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }

    // ----------------------------------------------------------------- //
    //  Default deny — everything outside the paths above                 //
    // ----------------------------------------------------------------- //
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
