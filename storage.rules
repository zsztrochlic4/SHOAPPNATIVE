rules_version = '2';

// StrengthHub — Cloud Storage security rules.
service firebase.storage {
  match /b/{bucket}/o {

    // Public exercise library (posters + form clips). Anyone can VIEW it so the
    // app loads media without a login, but no one can upload/change it from the
    // app — you manage these files from the Firebase console.
    match /exercises/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Each user's own media (e.g. progress photos) — owner-only. Uploads must be
    // images and under 10MB per file; reads are scoped to the owner.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 10 * 1024 * 1024        // 10MB cap per file
                    && request.resource.contentType.matches('image/.*'); // images only
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
