rules_version = '2';

// StrengthHub — Cloud Storage security rules (hardened per Hardening Plan v3 §5).
//
// Trust zones:
//   exercises/**   Zone C — public immutable assets (posters + form clips):
//                  world-readable, no client write, administered from the console.
//   users/**       Zone A — reserved for future per-user media. The app has NO
//                  user-upload implementation today, so we do NOT grant
//                  speculative recursive write access here (plan §5). Locked to
//                  default-deny until the progress-photo feature ships with its
//                  own precise, validated path.
//   everything else  default-deny.
service firebase.storage {
  match /b/{bucket}/o {

    // Zone C — public exercise library (posters + form clips). Anyone can VIEW
    // it so media loads without a login; no one can upload/change it from the
    // app — these files are managed from the Firebase console.
    //
    // NOTE (plan §5): the squat poster is currently served from a long-lived
    // download-token URL under `Thumbnails/` (see src/lib/media.ts). Migrate that
    // asset into this public `exercises/` namespace and revoke the old token, so
    // it is public through the documented model rather than a leaked token.
    match /exercises/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Zone A — per-user media. LOCKED until the upload feature exists (plan §5).
    // There are no existing user files (confirmed: the app has no upload path),
    // so denying here removes an unused, speculative write surface.
    //
    // When progress-photo uploads are implemented, DELETE this deny block and add
    // ONLY the precise path below, validated (plan §5 "When progress-photo
    // uploads are implemented"):
    //
    //   match /users/{uid}/progressPhotos/{photoId} {
    //     function isOwner() { return request.auth != null && request.auth.uid == uid; }
    //     allow read: if isOwner();
    //     allow create, update: if isOwner()
    //       && request.resource.size < 10 * 1024 * 1024                 // agreed cap
    //       && request.resource.contentType.matches('image/(jpeg|png|webp|heic)')
    //       && photoId.matches('^[A-Za-z0-9_-]{1,128}\\.(jpg|jpeg|png|webp|heic)$');
    //     allow delete: if isOwner();
    //   }
    //
    // contentType is client-supplied metadata — a useful filter, not malware or
    // file-signature validation. Any future shared/publicly-served upload must
    // pass through trusted backend processing (plan §5 note).
    match /users/{allPaths=**} {
      allow read, write: if false;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
