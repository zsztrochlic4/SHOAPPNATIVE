# StrengthHub Online — environment variables
#
# Copy to ".env" for local dev, or set these in your EAS build environment.
# These Firebase web-config values are NOT secrets (security is enforced by
# Firestore/Storage rules), so they're safe to commit as an example.
#
# NOTE: the legacy Claude-backed coach endpoint (api/coach.ts, ANTHROPIC_API_KEY)
# has been retired — the live coach uses firebase/ai (Gemini) and, per the
# Production Readiness plan §3/§4.4, moves server-side behind a trusted backend.

# ── Firebase web config (accounts + cloud data sync) ─────────────────────
# From Firebase console → Project settings → Your apps → Web app → firebaseConfig.
# These are NOT secrets (security is enforced by Firestore/Storage rules), so
# they're safe to commit. Copy this file to ".env" and fill them in. If they're
# blank the app runs in local demo mode with no login.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── App Check (abuse/attestation protection) ─────────────────────────────
# reCAPTCHA ENTERPRISE SITE key (public) — from the Firebase console → App Check
# after registering the web app (Hardening Plan v3 §9; Firebase recommends
# Enterprise for new web integrations). The client uses it once App Check is
# enabled in the console; blank = App Check stays a safe no-op. See
# src/lib/appCheck.ts and docs/security/HARDENING_RUNBOOK.md §9.
EXPO_PUBLIC_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=
# Legacy reCAPTCHA v3 key (still honoured as a fallback for older builds).
EXPO_PUBLIC_APPCHECK_RECAPTCHA_KEY=
# Optional debug token for LOCAL DEVELOPMENT / STAGING only (never in production).
# EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# ── Stripe paywall (4-week free trial → $2.99/week AUD) ───────────────────
# PUBLISHABLE key only (starts pk_test_… / pk_live_…) — public, safe to ship.
# The SECRET key, WEBHOOK signing secret and PRICE id live on the backend as
# Firebase Function secrets, NEVER here. Full setup: docs/STRIPE_SETUP.md.
# Blank = the paywall UI still renders but "Start free trial" has no backend.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
