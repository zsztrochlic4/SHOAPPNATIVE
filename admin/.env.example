# StrengthHub Admin — Firebase web config (optional overrides).
#
# These are NOT secrets (security is enforced by the owner claim + Firestore
# rules), so committing them is fine. src/firebase.ts already ships working
# defaults for the strengthhub-2ab33 project, so the app runs with NO .env.
#
# Only set these if you want to override — e.g. paste your Web app's exact
# apiKey/appId from Firebase console → Project settings → Your apps → Web app,
# if Google sign-in is ever rejected with the bundled key.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# Cloud Functions region (must match functions/src/index.ts setGlobalOptions).
VITE_FB_REGION=
