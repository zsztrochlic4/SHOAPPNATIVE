{
  "name": "strengthhub-native",
  "version": "1.0.0",
  "description": "StrengthHub Online — React Native (Expo) port of the SHO-app fitness PWA.",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "^57.0.4",
    "expo-auth-session": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-notifications": "~57.0.6",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-video": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "firebase": "^12.15.0",
    "lucide-react-native": "^1.20.0",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.2.2",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.2.0",
    "prettier": "^3.8.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "expo start --web --port 8081",
    "start": "expo start --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run check && npm run sweep && npm run test:safety && npm run test:unit",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node --test test/rules/*.test.mjs\"",
    "test:community": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions \"node --test test/community/functions.emulator.test.mjs\"",
    "test:safety": "tsc -p tsconfig.sweep.json && node --test \"test/safety/**/*.test.mjs\"",
    "test:unit": "tsc -p tsconfig.sweep.json && node --test \"test/unit/**/*.test.mjs\"",
    "check": "tsc -p tsconfig.check.json && node -e \"global.__DEV__=false; require('./.check-out/store/periods.check.js')\"",
    "sweep": "tsc -p tsconfig.sweep.json && node .sweep-out/backend/generator/runSweep.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format:scripts": "prettier --check \"scripts/**/*.{mjs,js}\"",
    "format:scripts:fix": "prettier --write \"scripts/**/*.{mjs,js}\"",
    "holdouts:build": "node scripts/build-holdouts.mjs",
    "validate:backend": "node scripts/validate-backend.mjs",
    "record:release": "node scripts/record-release.mjs",
    "validate:data": "node scripts/validate-data-sync.mjs",
    "validate:firestore": "node scripts/firestore-seed.js",
    "audit:schema": "node scripts/audit-production-schema.mjs",
    "validate:holdouts": "node scripts/validate-safety-holdouts.mjs",
    "validate:coach": "tsc -p tsconfig.sweep.json && node scripts/validate-coach-router.mjs",
    "benchmark:coach": "tsc -p tsconfig.sweep.json && node .sweep-out/backend/coach/eval/runConversationalBenchmark.js",
    "eval:response": "tsc -p tsconfig.sweep.json && node scripts/run-coach-response-eval.mjs",
    "eval:replies": "tsc -p tsconfig.sweep.json && node scripts/generate-coach-eval-replies.mjs",
    "eval:replies:safety": "tsc -p tsconfig.sweep.json && node scripts/capture-coach-safety-replies.mjs",
    "recipes:build": "node scripts/build-recipes.mjs",
    "recipes:upload": "node scripts/upload-recipes.mjs",
    "media:upload": "node scripts/upload-exercise-media.mjs",
    "media:folders": "node scripts/create-exercise-folders.mjs",
    "exercises:upload": "node scripts/upload-exercises.mjs",
    "workouts:build": "node scripts/build-quick-workouts.mjs",
    "workouts:upload": "node scripts/upload-workouts.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
